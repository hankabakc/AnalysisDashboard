# docker compose icin ornek. Bu dosyayi .env olarak kopyalayip degerleri doldurun; .env depoya girmez.

# Veritabani parolasi (compose'daki db servisi ve uygulama ayni degeri kullanir)
DB_PASSWORD=<veritabani-parolasi>

# JWT imzalama anahtari: en az 32 karakter, rastgele
JWT_SECRET=<en-az-32-karakterlik-rastgele-anahtar>

# Ilk acilista etkin yonetici yoksa "admin" hesabi bu parolayla acilir (en az 12 karakter).
# Hesap acildiktan sonra bu satiri bosaltin ve parolayi Kullanicilar ekranindan degistirin.
DASHBOARD_INITIAL_ADMIN_PASSWORD=

# Uygulamanin disaridan erisilecegi port (varsayilan 8080)
APP_PORT=8080
